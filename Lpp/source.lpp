
class ParticleGrid {
    function init(width, height) {
        this.width = width;
        this.height = height;
        this.cells = [];
        this.colors = [];
        for (local y = 0; y < height; y++) {
            local row = [];
            local cRow = [];
            for (local x = 0; x < width; x++) {
                push(row, 0);
                push(cRow, "white");
            }
            push(this.cells, row);
            push(this.colors, cRow);
        }
    }

    function get(x, y) {
        if x < 0 || x >= this.width || y < 0 || y >= this.height {
            return 1;
        }
        return this.cells[y][x];
    }

    function set(x, y, type, colorName) {
        if x >= 0 && x < this.width && y >= 0 && y < this.height {
            this.cells[y][x] = type;
            this.colors[y][x] = colorName;
        }
    }

    function clearAll() {
        for (local y = 0; y < this.height; y++) {
            for (local x = 0; x < this.width; x++) {
                this.cells[y][x] = 0;
                this.colors[y][x] = "white";
            }
        }
    }

    function countActiveParticles() {
        local count = 0;
        for (local y = 0; y < this.height; y++) {
            for (local x = 0; x < this.width; x++) {
                if this.cells[y][x] != 0 && this.cells[y][x] != 1 {
                    count++;
                }
            }
        }
        return count;
    }
}

class PhysicsEngine {
    function init(grid) {
        this.grid = grid;
        this.stepCounter = 0;
    }

    function update() {
        this.stepCounter++;
        local w = this.grid.width;
        local h = this.grid.height;

        for (local y = h - 2; y >= 0; y--) {
            local xOrder = range(0, w);
            shuffle(xOrder);

            for x in xOrder {
                local p = this.grid.get(x, y);

                if p == 2 {
                    this.updateSand(x, y);
                } else if p == 3 {
                    this.updateWater(x, y);
                } else if p == 4 {
                    this.updateFire(x, y);
                } else if p == 5 {
                    this.updateAcid(x, y);
                } else if p == 6 {
                    this.updateGunpowder(x, y);
                }
            }
        }
    }

    function updateSand(x, y) {
        local below = this.grid.get(x, y + 1);
        if below == 0 || below == 3 {
            local col = this.grid.colors[y][x];
            this.grid.set(x, y, below, this.grid.colors[y + 1][x]);
            this.grid.set(x, y + 1, 2, col);
            return;
        }

        local dir = (random(1, 2) == 1) ? -1 : 1;
        local bl = this.grid.get(x + dir, y + 1);
        if bl == 0 || bl == 3 {
            local col = this.grid.colors[y][x];
            this.grid.set(x, y, bl, this.grid.colors[y + 1][x + dir]);
            this.grid.set(x + dir, y + 1, 2, col);
            return;
        }

        local br = this.grid.get(x - dir, y + 1);
        if br == 0 || br == 3 {
            local col = this.grid.colors[y][x];
            this.grid.set(x, y, br, this.grid.colors[y + 1][x - dir]);
            this.grid.set(x - dir, y + 1, 2, col);
            return;
        }
    }

    function updateWater(x, y) {
        local below = this.grid.get(x, y + 1);
        if below == 0 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x, y + 1, 3, "cyan");
            return;
        }

        local dir = (random(1, 2) == 1) ? -1 : 1;
        local bl = this.grid.get(x + dir, y + 1);
        if bl == 0 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x + dir, y + 1, 3, "cyan");
            return;
        }

        local br = this.grid.get(x - dir, y + 1);
        if br == 0 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x - dir, y + 1, 3, "cyan");
            return;
        }

        local sl = this.grid.get(x + dir, y);
        if sl == 0 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x + dir, y, 3, "cyan");
            return;
        }

        local sr = this.grid.get(x - dir, y);
        if sr == 0 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x - dir, y, 3, "cyan");
            return;
        }
    }

    function updateFire(x, y) {
        if random(1, 10) > 6 {
            this.grid.set(x, y, 0, "white");
            return;
        }

        local offsets = [[0, -1], [1, 0], [-1, 0], [0, 1]];
        for off in offsets {
            local nx = x + off[0];
            local ny = y + off[1];
            local neighbor = this.grid.get(nx, ny);

            if neighbor == 3 {
                this.grid.set(x, y, 0, "white");
                beep(800, 20);
                return;
            } else if neighbor == 6 {
                this.explode(nx, ny);
                return;
            } else if neighbor == 2 {
                if random(1, 10) > 8 {
                    this.grid.set(nx, ny, 4, "red");
                }
            }
        }

        local up = this.grid.get(x, y - 1);
        if up == 0 && y > 0 {
            local drift = random(-1, 1);
            if this.grid.get(x + drift, y - 1) == 0 {
                this.grid.set(x, y, 0, "white");
                this.grid.set(x + drift, y - 1, 4, (random(1, 2) == 1) ? "red" : "yellow");
            }
        }
    }

    function updateAcid(x, y) {
        local below = this.grid.get(x, y + 1);
        if below != 0 && below != 1 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x, y + 1, 0, "white");
            beep(500, 30);
            return;
        }
        if below == 0 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x, y + 1, 5, "green");
            return;
        }

        local side = (random(1, 2) == 1) ? -1 : 1;
        local s = this.grid.get(x + side, y);
        if s != 0 && s != 1 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x + side, y, 0, "white");
            return;
        }
        if s == 0 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x + side, y, 5, "green");
            return;
        }
    }

    function updateGunpowder(x, y) {
        local below = this.grid.get(x, y + 1);
        if below == 0 || below == 3 {
            local col = this.grid.colors[y][x];
            this.grid.set(x, y, below, this.grid.colors[y + 1][x]);
            this.grid.set(x, y + 1, 6, col);
            return;
        }

        local dir = (random(1, 2) == 1) ? -1 : 1;
        local bl = this.grid.get(x + dir, y + 1);
        if bl == 0 {
            this.grid.set(x, y, 0, "white");
            this.grid.set(x + dir, y + 1, 6, "gray");
            return;
        }
    }

    function explode(cx, cy) {
        beep(220, 150);
        local radius = 3;
        for (local dy = -radius; dy <= radius; dy++) {
            for (local dx = -radius; dx <= radius; dx++) {
                local dist = sqrt((dx * dx) + (dy * dy));
                if dist <= radius {
                    local tx = cx + dx;
                    local ty = cy + dy;
                    if this.grid.get(tx, ty) != 1 {
                        if random(1, 10) > 4 {
                            this.grid.set(tx, ty, 4, "yellow");
                        } else {
                            this.grid.set(tx, ty, 0, "white");
                        }
                    }
                }
            }
        }
    }
}

class SandboxRenderer {
    function init() {
        this.glyphs = [" ", "█", "░", "≈", "*", "%", "o"];
    }

    function render(grid, cursorX, cursorY, selectedTool, toolNames, isRaining) {
        clear();
        color("magenta");
        print("┌────────────────────────────────────────────────────────┐");
        print("│      P O W D E R   S A N D B O X   P H Y S I C S       │");
        print("└────────────────────────────────────────────────────────┘");
        reset_color();

        local screen = "";
        for (local y = 0; y < grid.height; y++) {
            local line = "│";
            for (local x = 0; x < grid.width; x++) {
                if x == cursorX && y == cursorY {
                    line += "⊕";
                } else {
                    local t = grid.cells[y][x];
                    line += this.glyphs[t];
                }
            }
            line += "│";
            print(line);
        }

        color("magenta");
        print("└────────────────────────────────────────────────────────┘");
        reset_color();

        local currentToolName = toolNames[selectedTool];
        color("yellow");
        print($" TOOL: [{selectedTool}] {currentToolName}  │  POS: ({cursorX},{cursorY})  │  PARTICLES: {grid.countActiveParticles()}");
        reset_color();

        color("cyan");
        print(" [W,A,S,D]: Move │ [Space]: Drop │ [1-6]: Select Element");
        print(" [C]: Clear Grid │ [R]: Toggle Rain │ [H]: Hourglass │ [Q]: Quit");
        reset_color();

        if isRaining == 1 {
            color("green");
            print(">>> WEATHER EVENT: CHAOTIC PARTICLE STORM ACTIVE <<<");
            reset_color();
        }
    }
}

class PresetArchitect {
    function buildHourglass(grid) {
        grid.clearAll();
        local w = grid.width;
        local h = grid.height;
        local cx = floor(w / 2);

        for (local i = 0; i < 14; i++) {
            grid.set(cx - 10 + i, 2, 1, "white");
            grid.set(cx - 10 + i, h - 3, 1, "white");
        }

        for (local i = 0; i < 7; i++) {
            grid.set(cx - 10 + i, 2 + i, 1, "white");
            grid.set(cx + 4 - i, 2 + i, 1, "white");

            grid.set(cx - 4 + i, h - 3 - i, 1, "white");
            grid.set(cx - 2 - i, h - 3 - i, 1, "white");
        }

        for (local py = 4; py < 8; py++) {
            for (local px = cx - 5; px <= cx - 1; px++) {
                grid.set(px, py, 2, "yellow");
            }
        }
    }

    function buildVolcano(grid) {
        grid.clearAll();
        local w = grid.width;
        local h = grid.height;
        local cx = floor(w / 2);

        for (local y = 6; y < h; y++) {
            local spread = floor((y - 6) * 1.6);
            grid.set(cx - 4 - spread, y, 1, "white");
            grid.set(cx + 4 + spread, y, 1, "white");
        }

        for (local x = 0; x < w; x++) {
            grid.set(x, h - 1, 1, "white");
        }

        for (local gy = h - 4; gy < h - 1; gy++) {
            for (local gx = cx - 6; gx <= cx + 6; gx++) {
                grid.set(gx, gy, 6, "gray");
            }
        }

        grid.set(cx, 7, 4, "red");
        grid.set(cx - 1, 7, 4, "yellow");
    }
}

local width = 42;
local height = 18;
local grid = new ParticleGrid(width, height);
local physics = new PhysicsEngine(grid);
local renderer = new SandboxRenderer();
local architect = new PresetArchitect();

for (local x = 0; x < width; x++) {
    grid.set(x, height - 1, 1, "white");
}
for (local y = 0; y < height; y++) {
    grid.set(0, y, 1, "white");
    grid.set(width - 1, y, 1, "white");
}

local cursorX = floor(width / 2);
local cursorY = floor(height / 2);

local toolNames = {
    "1": "Sand",
    "2": "Water",
    "3": "Solid Wall",
    "4": "Fire",
    "5": "Acid",
    "6": "Gunpowder"
};

local selectedTool = "1";
local isRaining = 0;
local running = 1;

while running == 1 {
    physics.update();

    if isRaining == 1 {
        for (local r = 0; r < 3; r++) {
            local rx = random(1, width - 2);
            local rType = random(2, 3);
            local rCol = (rType == 2) ? "yellow" : "cyan";
            grid.set(rx, 1, rType, rCol);
        }
    }

    renderer.render(grid, cursorX, cursorY, selectedTool, toolNames, isRaining);

    for (local tick = 0; tick < 3; tick++) {
        if key_available() {
            local k = key();

            if k == "W" || k == "w" || k == "UpArrow" {
                cursorY--;
                if cursorY < 1 { cursorY = 1; }
            } else if k == "S" || k == "s" || k == "DownArrow" {
                cursorY++;
                if cursorY >= height - 1 { cursorY = height - 2; }
            } else if k == "A" || k == "a" || k == "LeftArrow" {
                cursorX--;
                if cursorX < 1 { cursorX = 1; }
            } else if k == "D" || k == "d" || k == "RightArrow" {
                cursorX++;
                if cursorX >= width - 1 { cursorX = width - 2; }
            } else if k == "Spacebar" || k == " " {
                local tNum = 2;
                local col = "yellow";
                if selectedTool == "1" {
                    tNum = 2;
                    col = "yellow";
                } else if selectedTool == "2" {
                    tNum = 3;
                    col = "cyan";
                } else if selectedTool == "3" {
                    tNum = 1;
                    col = "white";
                } else if selectedTool == "4" {
                    tNum = 4;
                    col = "red";
                } else if selectedTool == "5" {
                    tNum = 5;
                    col = "green";
                } else if selectedTool == "6" {
                    tNum = 6;
                    col = "gray";
                }

                grid.set(cursorX, cursorY, tNum, col);
                grid.set(cursorX + 1, cursorY, tNum, col);
            } else if k == "1" || k == "D1" {
                selectedTool = "1";
            } else if k == "2" || k == "D2" {
                selectedTool = "2";
            } else if k == "3" || k == "D3" {
                selectedTool = "3";
            } else if k == "4" || k == "D4" {
                selectedTool = "4";
            } else if k == "5" || k == "D5" {
                selectedTool = "5";
            } else if k == "6" || k == "D6" {
                selectedTool = "6";
            } else if k == "C" || k == "c" {
                grid.clearAll();
                for (local x = 0; x < width; x++) { grid.set(x, height - 1, 1, "white"); }
                for (local y = 0; y < height; y++) { grid.set(0, y, 1, "white"); grid.set(width - 1, y, 1, "white"); }
                beep(400, 80);
            } else if k == "R" || k == "r" {
                isRaining = (isRaining == 1) ? 0 : 1;
                beep(700, 50);
            } else if k == "H" || k == "h" {
                architect.buildHourglass(grid);
                beep(900, 100);
            } else if k == "V" || k == "v" {
                architect.buildVolcano(grid);
                beep(300, 150);
            } else if k == "Q" || k == "q" || k == "Escape" {
                running = 0;
                break;
            }
        }
        sleep(0.02);
    }
}

clear();
color("cyan");
print("Physics Sandbox closed cleanly.");
reset_color();
